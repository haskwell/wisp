#include "platform/wayland/protocol/opcodes.hpp"
#include "platform/wayland/display.hpp"
#include <iostream>
#include <sys/mman.h>
#include <unistd.h>
#include <fcntl.h>
#include <stdexcept>

uint32_t DISPLAY_ID = 1;
uint32_t REGISTRY_ID = 2;
uint32_t CALLBACK_ID = 3;
uint32_t COMPOSITOR_ID = 4;
uint32_t SHM_ID = 5;
uint32_t XDG_WM_BASE_ID = 6;
uint32_t ZXDG_MANAGER_ID = 7;
uint32_t SURFACE_ID = 8;
uint32_t XDG_SURFACE_ID = 9;
uint32_t XDG_TOPLEVEL_ID = 10;
uint32_t ZXDG_TOPLEVEL_ID = 11;
uint32_t SHM_POOL_ID = 12;
uint32_t BUFFER_ID = 13;

struct Global{
    uint32_t name;
    std::string interface;
    uint32_t version;
};

const Global* findGlobal(std::vector<Global>& globals, std::string interface){
    for(const auto& g : globals){
        if(g.interface == interface) return &g;
    }
    return nullptr;
}

int main() {
    Display display;
    
    //wl display get resigtry (make registry object)
    serializer.beginMessage(1, wl_display::Request::GET_REGISTRY);
    serializer.append_uint<uint32_t>(REGISTRY_ID);
    serializer.finishMessage();

    connection.sendMessage(serializer.getMessage());

    //wl display sync (make callback object)
    serializer.beginMessage(1, wl_display::Request::SYNC);
    serializer.append_uint<uint32_t>(CALLBACK_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());
    
    uint32_t id{};
    std::vector<Global> globals;
    while(id != 3){
        Global g;
        RecievedMessage r = connection.receiveMessage();
        deserializer.startDeserializer(r.message);
        id = deserializer.readObjectID();
        uint16_t code = deserializer.readOpcode();
        uint16_t len = deserializer.readMessageLength();
        if(id == DISPLAY_ID && code == static_cast<uint16_t>(wl_display::Event::ERROR)){
            return 1;
        }
        if(id == CALLBACK_ID && code == static_cast<uint16_t>(wl_callback::Event::DONE)) break;
        //name
        if(id == REGISTRY_ID && code == static_cast<uint16_t>(wl_registry::Event::GLOBAL)){
            g.name = deserializer.readUnsignedInteger<uint32_t>();
            //string
            g.interface = deserializer.readString();
            //version
            g.version = deserializer.readUnsignedInteger<uint32_t>();
            globals.push_back(g);
        }
    }
    //bind wlcompositor, wlshm and xdgbase
    const Global* compositor = findGlobal(globals, "wl_compositor");
    const Global* shm = findGlobal(globals, "wl_shm");
    const Global* xdgbase = findGlobal(globals, "xdg_wm_base");

    const Global* zxdgmanager = findGlobal(globals, "zxdg_decoration_manager_v1");

    if(compositor == nullptr || shm == nullptr || xdgbase == nullptr) return 1;
    serializer.beginMessage(REGISTRY_ID, wl_registry::Request::BIND);
    serializer.append_uint(compositor->name);
    serializer.appendString(compositor->interface);
    serializer.append_uint(compositor->version);
    serializer.append_uint(COMPOSITOR_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    serializer.beginMessage(REGISTRY_ID, wl_registry::Request::BIND);
    serializer.append_uint(shm->name);
    serializer.appendString(shm->interface);
    serializer.append_uint(shm->version);
    serializer.append_uint(SHM_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    serializer.beginMessage(REGISTRY_ID, wl_registry::Request::BIND);
    serializer.append_uint(xdgbase->name);
    serializer.appendString(xdgbase->interface);
    serializer.append_uint(xdgbase->version);
    serializer.append_uint(XDG_WM_BASE_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    if(zxdgmanager){
        serializer.beginMessage(REGISTRY_ID, wl_registry::Request::BIND);
        serializer.append_uint(zxdgmanager->name);
        serializer.appendString(zxdgmanager->interface);
        serializer.append_uint(zxdgmanager->version);
        serializer.append_uint(ZXDG_MANAGER_ID);
        serializer.finishMessage();
        connection.sendMessage(serializer.getMessage());
    }
    
    //create wlsurface
    serializer.beginMessage(COMPOSITOR_ID, wl_compositor::Request::CREATE_SURFACE);
    serializer.append_uint(SURFACE_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    //create xdg surface
    serializer.beginMessage(XDG_WM_BASE_ID, xdg_wm_base::Request::GET_XDG_SURFACE);
    serializer.append_uint(XDG_SURFACE_ID);
    serializer.append_uint(SURFACE_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    //create toplevel
    serializer.beginMessage(XDG_SURFACE_ID, xdg_surface::Request::GET_TOPLEVEL);
    serializer.append_uint(XDG_TOPLEVEL_ID);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    //set title
    serializer.beginMessage(XDG_TOPLEVEL_ID, xdg_toplevel::Request::SET_TITLE);
    serializer.appendString("hello");
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    if(zxdgmanager){
        serializer.beginMessage(ZXDG_MANAGER_ID, zxdg_decoration_manager_v1::Request::GET_TOPLEVEL_DECORATION);
        serializer.append_uint(ZXDG_TOPLEVEL_ID);
        serializer.append_uint(XDG_TOPLEVEL_ID);
        serializer.finishMessage();
        connection.sendMessage(serializer.getMessage());

        serializer.beginMessage(ZXDG_TOPLEVEL_ID, zxdg_toplevel_decoration_v1::Request::SET_MODE);
        serializer.append_uint(static_cast<uint32_t>(zxdg_toplevel_decoration_v1::Mode::SERVER_SIDE));
        serializer.finishMessage();
        connection.sendMessage(serializer.getMessage());
    }

    //commit
    serializer.beginMessage(SURFACE_ID, wl_surface::Request::COMMIT);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    int32_t width = 0, height = 0;
    uint32_t serial{};
    bool configured = false;
    while(!configured){
        RecievedMessage res = connection.receiveMessage();
        deserializer.startDeserializer(res.message);
        //id, code, len
        uint32_t id = deserializer.readObjectID();
        uint16_t code = deserializer.readOpcode();
        uint16_t len = deserializer.readMessageLength();
        if(id == ZXDG_TOPLEVEL_ID && code == static_cast<uint16_t>(zxdg_toplevel_decoration_v1::Event::CONFIGURE)){
            uint32_t mode = deserializer.readUnsignedInteger<uint32_t>();
            std::cout << "Mode is: " << mode << '\n';
        }
        if(id == XDG_TOPLEVEL_ID && code == static_cast<uint16_t>(xdg_toplevel::Event::CONFIGURE)){
            width = deserializer.readSignedInteger<int32_t>();
            height = deserializer.readSignedInteger<int32_t>();
        }
        if(id == XDG_SURFACE_ID && code == static_cast<uint16_t>(xdg_surface::Event::CONFIGURE)){
            serial = deserializer.readUnsignedInteger<uint32_t>();
            serializer.beginMessage(XDG_SURFACE_ID, xdg_surface::Request::ACK_CONFIGURE);
            serializer.append_uint<uint32_t>(serial);
            serializer.finishMessage();
            connection.sendMessage(serializer.getMessage());
            break;
        }
        if(id == XDG_WM_BASE_ID && code == static_cast<uint16_t>(xdg_wm_base::Event::PING)){
            uint32_t ping = deserializer.readUnsignedInteger<uint32_t>();
            serializer.beginMessage(XDG_WM_BASE_ID, xdg_wm_base::Request::PONG);
            serializer.append_uint<uint32_t>(ping);
            serializer.finishMessage();
            connection.sendMessage(serializer.getMessage());
        }
    }

    if(width == 0) width = 800;
    if(height == 0) height = 600;

    int bufferFd = memfd_create("wayland-buffer", MFD_CLOEXEC);
    if(bufferFd < 0){
        throw std::runtime_error("shm creation failed");
    }

    int stride = width * 4;
    uint32_t size = width * height * 4;
    ftruncate(bufferFd, size);

    void* shm_data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, bufferFd, 0);

    uint32_t* pixels = static_cast<uint32_t*>(shm_data);
    for(size_t i = 0; i < static_cast<size_t>(width) * height; i++){
        pixels[i] = 0xFF3366CC;
    }

    serializer.beginMessage(SHM_ID, wl_shm::Request::CREATE_POOL);
    serializer.append_uint(SHM_POOL_ID);
    serializer.append_uint(size);
    serializer.finishMessage();
    std::vector<int> fds;
    fds.push_back(bufferFd);
    connection.sendMessage(serializer.getMessage(), fds);

    serializer.beginMessage(SHM_POOL_ID, wl_shm_pool::Request::CREATE_BUFFER);
    serializer.append_uint(BUFFER_ID);
    serializer.append_int<int32_t>(0);
    serializer.append_int<int32_t>(width);
    serializer.append_int<int32_t>(height);
    serializer.append_int<int32_t>(stride);
    serializer.append_uint<uint32_t>(static_cast<uint32_t>(wl_shm::Format::ARGG8888));
    serializer.finishMessage();

    connection.sendMessage(serializer.getMessage());

    serializer.beginMessage(SURFACE_ID, wl_surface::Request::ATTACH);
    serializer.append_uint(BUFFER_ID);
    serializer.append_int<int32_t>(0);
    serializer.append_int<int32_t>(0);
    serializer.finishMessage();
    
    connection.sendMessage(serializer.getMessage());

    serializer.beginMessage(SURFACE_ID, wl_surface::Request::DAMAGE_BUFFER);
    serializer.append_int<int32_t>(0);
    serializer.append_int<int32_t>(0);
    serializer.append_int<int32_t>(width);
    serializer.append_int<int32_t>(height);
    serializer.finishMessage();

    connection.sendMessage(serializer.getMessage());

    serializer.beginMessage(SURFACE_ID, wl_surface::Request::COMMIT);
    serializer.finishMessage();
    connection.sendMessage(serializer.getMessage());

    bool running = true;
    while(running){
        RecievedMessage res = connection.receiveMessage();
        deserializer.startDeserializer(res.message);
        //id, code, len
        uint32_t id = deserializer.readObjectID();
        uint16_t code = deserializer.readOpcode();
        uint16_t len = deserializer.readMessageLength();
        if(id == 1 && code == static_cast<uint16_t>(wl_display::Event::ERROR)){
            uint32_t id = deserializer.readUnsignedInteger<uint32_t>();
            uint32_t err = deserializer.readUnsignedInteger<uint32_t>();
            std::string error = deserializer.readString();
            std::cout << id << '\n' << err << '\n' << error << '\n';
            throw std::runtime_error("display error, see console for details");
        }
        if(id == XDG_WM_BASE_ID && code == static_cast<uint16_t>(xdg_wm_base::Event::PING)){
            uint32_t ping = deserializer.readUnsignedInteger<uint32_t>();
            serializer.beginMessage(XDG_WM_BASE_ID, xdg_wm_base::Request::PONG);
            serializer.append_uint<uint32_t>(ping);
            serializer.finishMessage();
            connection.sendMessage(serializer.getMessage());
        }
        if(id == XDG_TOPLEVEL_ID && code == static_cast<uint16_t>(xdg_toplevel::Event::CLOSE)){
            running = false;
        }
    }
    munmap(shm_data, size);
    close(bufferFd);
    return 0;
}
